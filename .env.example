# Copy to .env.local and fill in. Never commit real values.

# --- Browser (inlined at build time: rebuild after changing) ---
# Meta Pixel / dataset id. Unset = the pixel is not loaded at all.
# The value below is the id used by the automated tests, not a real pixel.
NEXT_PUBLIC_META_PIXEL_ID=1234567890123456
# How the contact form works: "whatsapp" (default, opens WhatsApp, no data collected)
# or "form" (requires name + phone, posts to /api/lead, then opens WhatsApp).
NEXT_PUBLIC_LEAD_MODE=whatsapp

# --- Server only (runtime) ---
# Conversions API access token (Events Manager > Settings). Unset = dry run, nothing leaves the server.
META_CAPI_ACCESS_TOKEN=
# Events Manager "Test events" code. Set only while testing; remove for real traffic.
META_TEST_EVENT_CODE=
# Graph API version for the CAPI call. Default v21.0.
META_GRAPH_VERSION=v21.0
# Full URL that replaces graph.facebook.com (used by tests to point at a local mock).
META_CAPI_ENDPOINT=
# URL that receives each form lead as JSON (Zapier, Make, Apps Script...). Unset = dry run.
LEAD_WEBHOOK_URL=

# --- Tests only ---
# Set by playwright.config.ts: lets tests switch lead mode per browser. Leave unset in production.
# NEXT_PUBLIC_E2E=1
