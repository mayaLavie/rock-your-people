# Copy to .env.local and fill in. Never commit real values.

# --- Browser (inlined at build time: rebuild after changing) ---
# Meta Pixel / dataset id. Unset = the pixel is not loaded at all.
# The value below is the id used by the automated tests, not a real pixel.
NEXT_PUBLIC_META_PIXEL_ID=1234567890123456
# How the contact form works: "whatsapp" (default, opens WhatsApp, no data collected)
# or "form" (requires name + phone, posts to /api/lead, then opens WhatsApp).
NEXT_PUBLIC_LEAD_MODE=whatsapp

# Optional estimated value of one lead, in ILS (a positive number, e.g. 150). When set, the Lead
# event carries value + currency=ILS; when unset, neither is sent. Do not invent a number.
NEXT_PUBLIC_LEAD_VALUE=
# Public site URL. Its host (and the www/non-www twin) is the Origin/Referer allowlist for
# /api/meta/event, /api/lead and /api/consent. localhost is also allowed in dev and test builds.
NEXT_PUBLIC_SITE_URL=https://rockyourpeople.com

# --- Server only (runtime) ---
# REQUIRED in production. Secret (32+ random characters, e.g. `openssl rand -base64 32`) that signs
# the first-party consent cookie `ryp_consent` (HMAC-SHA256). Without it /api/consent answers 503 and
# /api/meta/event rejects every event (fails closed). In dev/test an insecure fallback is used and a
# warning is logged.
CONSENT_COOKIE_SECRET=
# Number of proxies in front of the app, used to read the client IP from x-forwarded-for (counted
# from the right). Default 1. On Vercel the trusted x-vercel-forwarded-for header is used first, then
# x-real-ip, so this only matters elsewhere.
TRUSTED_PROXY_HOPS=1
# Conversions API access token (Events Manager > Settings). Unset = dry run, nothing leaves the server.
META_CAPI_ACCESS_TOKEN=
# Events Manager "Test events" code. Set only while testing; remove for real traffic.
META_TEST_EVENT_CODE=
# Graph API version for the CAPI call. Default v21.0.
META_GRAPH_VERSION=v21.0
# Full URL that replaces graph.facebook.com (used by tests to point at a local mock).
META_CAPI_ENDPOINT=
# URL that receives each form lead as JSON (Zapier, Make, Apps Script...). Unset = dry run.
LEAD_WEBHOOK_URL=

# --- Tests only ---
# Set by playwright.config.ts: lets tests switch lead mode per browser. Leave unset in production.
# NEXT_PUBLIC_E2E=1
